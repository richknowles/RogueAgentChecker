  "scoring": {
    "suspiciousThreshold": 40,
    "indicators": {
      "LongRunning":              { "weight": 10, "description": "Agent process has been running longer than the long-running threshold" },
      "RemoteDebuggingPort":      { "weight": 30, "description": "Browser exposes the Chrome DevTools Protocol, which allows full remote control of the browser and its sessions" },
      "ListensOnAllInterfaces":   { "weight": 35, "description": "Agent or model service listens on all network interfaces, so other machines can drive it" },
      "RemoteClientOnAgentPort":  { "weight": 30, "description": "Another machine is connected to a local agent or model port" },
      "UserWritableExecPath":     { "weight": 30, "description": "Runs from a user-writable staging folder (Temp, Downloads, Public)" },
      "StealthLaunch":            { "weight": 40, "description": "Launched hidden or with an encoded command line" },
      "SystemContext":            { "weight": 30, "description": "Runs as SYSTEM or a service account rather than as a person" },
      "LlmFromNonAgentProcess":   { "weight": 40, "description": "A process that is not a known AI application is talking to an LLM API" },
      "PersistentLlmConnection":  { "weight": 10, "description": "Connection to an LLM API has stayed open for a long time or across samples" },
      "PersistenceAutostart":     { "weight": 10, "description": "Starts automatically without a person launching it" },
      "PersistenceWmi":           { "weight": 50, "description": "Uses a WMI event subscription, a stealth persistence technique" },
      "HiddenTask":               { "weight": 20, "description": "Scheduled task is marked hidden" },
      "SecretInPlaintext":        { "weight": 15, "description": "An AI provider key or token is stored in a plaintext file" },
      "SecretWorldReadable":      { "weight": 40, "description": "A file holding a key or token is readable by Everyone, Users, or Authenticated Users" },
      "MachineWideSecret":        { "weight": 25, "description": "An AI provider key is set machine-wide, so every user and process inherits it" },
      "StoredOAuthToken":         { "weight": 10, "description": "Stored OAuth or session token for an AI application" },
      "ShellCapableMcp":          { "weight": 15, "description": "MCP server gives the agent shell or file-system access" },
      "RemoteMcpServer":          { "weight": 15, "description": "MCP server runs on a remote host the organization may not control" },
      "UnpinnedPackage":          { "weight": 10, "description": "MCP server is launched from an unpinned package (npx -y / uvx without a version), so code can change on every run" },
      "BrowserControlPermission": { "weight": 20, "description": "Browser extension holds debugger or native-messaging permission (can drive the browser)" },
      "BrowserControlBridge":     { "weight": 15, "description": "Native messaging host lets a local program talk to the browser" },
      "OffHoursActivity":         { "weight": 15, "description": "Agent activity outside business hours" },
      "CrossAppReach":            { "weight": 20, "description": "One agent identity can act across three or more application categories" },
      "LethalTrifecta":           { "weight": 30, "description": "Agent combines private-data access, untrusted input, and an outbound channel (prompt-injection exfiltration risk)" },
      "RecentPackageInstall":     { "weight": 10, "description": "Agent software was installed within the lookback window" },
      "AgentInstallsPackages":    { "weight": 20, "description": "An agent process launched package installs on its own" },
      "SelfModification":         { "weight": 20, "description": "Agent skills, memory, or instruction files changed within the lookback window" },
      "SelfModificationByAgent":  { "weight": 15, "description": "Event logs show an agent process writing to its own skills or memory" },
      "AgentSpawnedShell":        { "weight": 10, "description": "Agent process launched command shells" },
      "LlmCallFromScript":        { "weight": 25, "description": "A PowerShell script block called an LLM API directly" }
    }
  }
}
